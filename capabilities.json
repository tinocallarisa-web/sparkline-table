{
  "dataRoles": [
    {
      "displayName": "Rows",
      "displayNameKey": "Role_Rows",
      "name": "rows",
      "kind": "Grouping",
      "description": "Row hierarchy: up to three fields, outermost first.",
      "descriptionKey": "Role_Rows_Desc"
    },
    {
      "displayName": "Period",
      "displayNameKey": "Role_Period",
      "name": "period",
      "kind": "Grouping",
      "description": "Time axis of the sparklines: a month, week or date field.",
      "descriptionKey": "Role_Period_Desc"
    },
    {
      "displayName": "Values",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure",
      "description": "One to three measures. The first one draws the sparkline.",
      "descriptionKey": "Role_Values_Desc"
    },
    {
      "displayName": "Target",
      "displayNameKey": "Role_Target",
      "name": "target",
      "kind": "Measure",
      "description": "Measure drawn as a target line on every sparkline.",
      "descriptionKey": "Role_Target_Desc"
    },
    {
      "displayName": "Row image (Pro)",
      "displayNameKey": "Role_RowImage",
      "name": "rowImage",
      "kind": "Measure",
      "description": "Image at the start of each row: a text measure or column (First) with a data:image Base64 URI. Web links are not loaded.",
      "descriptionKey": "Role_RowImage_Desc"
    },
    {
      "displayName": "Plan (Pro)",
      "displayNameKey": "Role_Plan",
      "name": "plan",
      "kind": "Measure",
      "description": "Planned or budgeted figure. Shown in the tooltip; variance columns are part of the Pro plan.",
      "descriptionKey": "Role_Plan_Desc"
    },
    {
      "displayName": "Prior year (Pro)",
      "displayNameKey": "Role_PreviousYear",
      "name": "previousYear",
      "kind": "Measure",
      "description": "The same figure for the prior year. Shown in the tooltip; variance columns are part of the Pro plan.",
      "descriptionKey": "Role_PreviousYear_Desc"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Extra measures shown in the tooltip.",
      "descriptionKey": "Role_Tooltips_Desc"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "rows": {
            "max": 3
          },
          "period": {
            "max": 1
          },
          "values": {
            "max": 3
          },
          "target": {
            "max": 1
          },
          "plan": {
            "max": 1
          },
          "previousYear": {
            "max": 1
          },
          "tooltips": {
            "max": 5
          },
          "rowImage": {
            "max": 1
          }
        }
      ],
      "matrix": {
        "rows": {
          "for": {
            "in": "rows"
          },
          "dataReductionAlgorithm": {
            "window": {
              "count": 1000
            }
          }
        },
        "columns": {
          "for": {
            "in": "period"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 400
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "target"
              }
            },
            {
              "for": {
                "in": "plan"
              }
            },
            {
              "for": {
                "in": "previousYear"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            },
            {
              "for": {
                "in": "rowImage"
              }
            }
          ]
        }
      }
    }
  ],
